# Copy to email-worker/.env on the server and fill in. Never commit the real .env.

# Supabase project URL and SERVICE ROLE key (Project Settings → API).
# The service role key bypasses row-level security — keep it only on the server.
SUPABASE_URL=https://pkoaxfxejgaawtwnkhvk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Gmail SMTP. SMTP_PASS must be a Google App Password (Google Account → Security →
# 2-Step Verification → App passwords), not the normal Gmail password.
# Optional: a mail server saved in Email Triggers → Setup takes priority over these four.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=connectiqo@gmail.com
SMTP_PASS=

# Sender shown to recipients (Gmail only allows your own address or a verified alias).
# Email Triggers → Setup can override these four without a restart; these are the fallback.
MAIL_FROM_EMAIL=connectiqo@gmail.com
MAIL_FROM_NAME=Connectiqo
MAIL_REPLY_TO=contact@connectiqo.com
SUPPORT_EMAIL=contact@connectiqo.com

# Links inside the emails.
PORTAL_URL=https://app.connectiqo.com

# Tuning (defaults shown).
POLL_INTERVAL_MS=30000
BATCH_SIZE=10
SEND_DELAY_MS=1500

# ── Safety: who may receive email ───────────────────────────────────────────
# Restart the worker after changing these. To stop sending at once, use Pause all emails in the panel.
# ALLOWED_RECIPIENTS → TEST MODE: only these addresses (comma-separated) get automatic email;
#   every other recipient is marked "skipped" and never retried. Empty = no automatic email.
# SEND_TO_EVERYONE=true → LIVE for all users. Only after manual testing is approved.
#   This is the only way to go live; the panel can't do it. Leave ALLOWED_RECIPIENTS empty.
# DRY_RUN only applies until migration 20261031000000 is applied. With DRY_RUN=false the worker
#   refuses to start unless one of the two above is set.
DRY_RUN=true
ALLOWED_RECIPIENTS=ramvish9923@gmail.com
SEND_TO_EVERYONE=false
